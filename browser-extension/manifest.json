{
  "manifest_version": 3,
  "name": "Codex Buddie — Browser",
  "version": "0.1.0",
  "description": "Replace the ChatGPT browser extension's agent cursor with Bit. Experimental companion; independent of OpenAI.",
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["assets/atlas.js", "adapter.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["assets/bit-atlas.png"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
